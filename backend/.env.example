# Copy to .env and adjust. Every setting can also come from the environment.

# Address and port to listen on
IRIS_HOST=0.0.0.0
IRIS_PORT=8080

# local, dev or prod; shown in the web remote unless prod
IRIS_ENV=local

# Where pairing credentials are stored (pyatv.conf). Keep this out of the repo.
IRIS_DATA_DIR=~/.local/share/iris/local

# Apple TV IPs to scan directly, comma-separated. Empty means a multicast scan.
IRIS_SCAN_HOSTS=172.16.0.242

# Built web remote to serve at /. Empty means API only.
IRIS_STATIC_DIR=../web/dist/spa

# If set, API calls need "Authorization: Bearer <token>"
IRIS_AUTH_TOKEN=

IRIS_LOG_LEVEL=info
